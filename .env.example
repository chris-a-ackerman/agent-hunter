PARLEY_API_KEY=
PARLEY_BASE_URL=https://parley.api.mit.edu/v1
# Label recorded on every cost row, e.g. chris / nathalie
PARLEY_ACCOUNT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MONTHLY_BUDGET_USD=25
DOCILE_TOKEN=
# Mock providers (AGE-18): uv run python -m mocks.fake_providers --port 8101
MOCK_PROVIDERS_BASE_URL=http://localhost:8101
MOCK_PROVIDER_SLUGS=mock-a,mock-b,mock-c,mock-d,mock-e
# run_job --mock: per-task deadline for the mocks (mock-d always times out)
MOCK_TASK_DEADLINE_MS=5000
TRUTH_DIR=data/truth
# Scorer switch (AGE-16): real = core/eval/scorer, mock = mocks/fake_scorer (run_job --mock forces it)
SCORER=real
# Job store (AGE-7, D21): local JSON files; gitignored
STORE_DIR=.data/store
# Provider registry (D22): the real provider service (agent-hunter-providers, port 8100),
# or point at the mock server above (port 8101, MOCK_PROVIDER_SLUGS)
PROVIDERS_BASE_URL=http://localhost:8100
PROVIDER_SLUGS=docuvant,northledger,paperlark,parsewell,quillbase,tallyforge,veridex
# Documents (D17): PDFs served by the core API at {DOCS_BASE_URL}/d/{doc_id}.pdf
DOCS_BASE_URL=http://localhost:8200
DOCS_DIR=data/docs
# Pipeline (AGE-9): base dir for posting sample paths
SAMPLES_DIR=examples
# Trial Runner (AGE-15): per-task deadline sent to providers; tasks in flight at once
TASK_DEADLINE_MS=60000
MAX_CONCURRENCY=24
