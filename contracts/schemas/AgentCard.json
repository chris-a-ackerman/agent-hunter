{
  "description": "Served at GET {base_url}/p/{slug}/.well-known/agent-card.json.",
  "properties": {
    "slug": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Slug",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "version": {
      "pattern": "^[^@\\s]+$",
      "title": "Version",
      "type": "string"
    },
    "job_types": {
      "items": {
        "type": "string"
      },
      "title": "Job Types",
      "type": "array"
    },
    "price_per_doc_usd": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "List price; used only by the Candidate Finder's budget filter (D19). None = unknown (a plain A2A card), which fails that filter",
      "title": "Price Per Doc Usd"
    },
    "region": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "\"global\", a region code, or None when unknown",
      "title": "Region"
    }
  },
  "required": [
    "slug",
    "name",
    "description",
    "version",
    "job_types"
  ],
  "title": "AgentCard",
  "type": "object"
}
